{
  "manifest_version": 3,
  "name": "GSC Agent",
  "version": "0.3.3",
  "description": "将当前 Search Console 标签页连接到本机 agent。",
  "permissions": [
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "https://search.google.com/*"
  ],
  "action": {
    "default_title": "连接当前 GSC 标签页"
  },
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "key": ""
}
